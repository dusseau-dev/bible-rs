{
	"name": "bible-rs-lander",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"auth:password": "node scripts/set-password.mjs",
		"test:e2e": "playwright test",
		"dev": "vite dev",
		"build": "vite build",
		"check:private-build": "node scripts/check-private-build.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"agentation": "^3.1.2",
		"ajv": "^8.20.0",
		"happy-dom": "^21.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@upstash/ratelimit": "^2.2.0",
		"@upstash/redis": "^1.41.0",
		"@vercel/analytics": "^2.0.1",
		"three": "^0.186.1"
	},
	"overrides": {
		"@vercel/analytics": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
